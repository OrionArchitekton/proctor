ANTHROPIC_API_KEY=sk-ant-...

# Gateway selector: local (default, no creds) | testcloud (live UiPath)
PROCTOR_GATEWAY=local

# ── UiPath Test Cloud (only needed when PROCTOR_GATEWAY=testcloud) ──
# Required:
UIPATH_BASE_URL=https://cloud.uipath.com   # Automation Cloud base URL
UIPATH_TENANT=                             # UiPath tenant name ({tenantName} URL segment)
UIPATH_PAT=                                # Personal Access Token (sent as Bearer)
# Required for real Cloud calls (asserted where used):
UIPATH_ORG=                                # Organization name ({organizationName} URL segment)
UIPATH_FOLDER_ID=                          # Orchestrator folder / OrganizationUnit id (X-UIPATH-OrganizationUnitId)
UIPATH_PROCTOR_RELEASE_KEY=                # ReleaseKey (UUID) of the Proctor orchestration process (StartJobs)
UIPATH_TEST_SET_ID=                        # Test Set id Proctor reports results against
# Optional:
UIPATH_TASK_CATALOG=                       # Action Center task catalog name for external tasks (omit if unused)
